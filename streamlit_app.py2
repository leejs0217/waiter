  { id: 'W-3021', rating: 4.8, jobs: 167, area: '강남·서초', tags: ['인기 상품'], online: true, verified: true },
  { id: 'W-5530', rating: 4.7, jobs: 98, area: '종로·중구', tags: ['맛집', '팝업'], online: false, verified: true },
