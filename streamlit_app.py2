            </div>
            <div class="font-semibold text-lg mt-6">${s.title}</div>
            <p class="text-sm text-mute mt-1">${s.desc}</p>
            <div class="h-1 rounded-full bg-line mt-6 overflow-hidden"><div class="h-full bg-brand" style="width:${(i + 1) * 33.4}%"></div></div>
          </div>`).join('')}
      </div>
    </section>

    <section class="mt-12">
      ${sectionHead('지금 뜨는 웨이팅', '실시간 시세 기준', `<button data-go="market" class="text-sm text-mute hover:text-ink inline-flex items-center gap-1">전체 보기<i data-lucide="chevron-right" class="w-4 h-4"></i></button>`)}
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        ${MARKET.slice(0, 4).map(marketCard).join('')}
      </div>
    </section>`;
  },

  market() {
    const cats = ['전체', '팝업', '인기 상품', '맛집'];
    const q = state.marketQuery.trim();
    const list = MARKET.filter(m => (state.marketCat === '전체' || m.cat === state.marketCat) && (!q || m.name.includes(q) || m.area.includes(q)));
    const avg = Math.round(MARKET.reduce((a, b) => a + b.price, 0) / MARKET.length / 1000) * 1000;
    return `
    ${sectionHead('시세 보기', '장소별 평균 웃돈과 대기 중인 웨이터 수를 확인하세요.')}
    <div class="grid grid-cols-3 gap-3 mb-6">
      <div class="card p-5"><div class="text-xs text-mute">평균 웃돈</div><div class="text-xl font-bold mt-1.5">${won(avg)}</div></div>
      <div class="card p-5"><div class="text-xs text-mute">최고 시세</div><div class="text-xl font-bold mt-1.5">${won(Math.max(...MARKET.map(m => m.price)))}</div></div>
      <div class="card p-5"><div class="text-xs text-mute">대기 웨이터</div><div class="text-xl font-bold mt-1.5">${MARKET.reduce((a, b) => a + b.waiters, 0)}명</div></div>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 sm:items-center justify-between mb-4">
      <div class="flex gap-1.5 flex-wrap">${cats.map(c => `<button class="chip chip-btn ${state.marketCat === c ? 'active' : ''}" data-cat="${c}">${c}</button>`).join('')}</div>
      <div class="relative sm:w-64">
        <i data-lucide="search" class="w-4 h-4 text-dim absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input id="marketSearch" class="field pl-9" placeholder="장소, 지역 검색" value="${state.marketQuery}" />
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="hidden md:grid grid-cols-12 px-5 py-3 text-xs text-dim border-b border-line">
        <div class="col-span-4">장소</div><div class="col-span-2">카테고리</div><div class="col-span-2">예상 대기</div><div class="col-span-2 text-right">평균 웃돈</div><div class="col-span-2 text-right">웨이터</div>
      </div>
      ${list.length ? list.map(m => `
        <div class="grid grid-cols-2 md:grid-cols-12 gap-y-1 items-center px-5 py-4 border-b border-line last:border-0 hover:bg-card transition">
          <div class="md:col-span-4"><div class="font-medium">${m.name}</div><div class="text-xs text-mute mt-0.5">${m.area}</div></div>
          <div class="md:col-span-2 hidden md:block"><span class="chip">${m.cat}</span></div>
          <div class="md:col-span-2 hidden md:block text-sm text-mute">${m.wait}</div>
          <div class="md:col-span-2 text-right"><div class="font-semibold">${won(m.price)}</div>${changeBadge(m.change)}</div>
          <div class="md:col-span-2 text-right text-sm text-mute col-span-2 md:col-auto"><span class="inline-flex items-center gap-1"><i data-lucide="users" class="w-3.5 h-3.5"></i>${m.waiters}명 대기</span></div>
        </div>`).join('') : `<div class="p-10 text-center text-sm text-mute">검색 결과가 없어요.</div>`}
    </div>`;
  },

  request() {
    return `
    ${sectionHead('의뢰하기', '정보를 입력하면 근처 웨이터에게 바로 알림이 가요.')}
    <div class="grid lg:grid-cols-5 gap-4">
      <form id="reqForm" class="card p-6 lg:col-span-3 space-y-5" novalidate>
        <div>
          <label class="label" for="rPlace">장소</label>
          <input id="rPlace" class="field" placeholder="예) 성수 팝업스토어" list="placeList" />
          <datalist id="placeList">${MARKET.map(m => `<option value="${m.name}">`).join('')}</datalist>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="label" for="rDate">날짜</label><input id="rDate" type="date" class="field" /></div>
          <div><label class="label" for="rTime">시작 시간</label><input id="rTime" type="time" class="field" value="09:00" /></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="label" for="rHours">예상 대기 시간</label>
            <select id="rHours" class="field"><option value="1">1시간 이내</option><option value="2" selected>1~2시간</option><option value="3">2~4시간</option><option value="5">4시간 이상</option></select></div>
          <div><label class="label" for="rFee">웃돈 (원)</label><input id="rFee" type="number" min="5000" step="1000" class="field" placeholder="30000" /></div>
        </div>
        <div id="feeHint" class="text-xs text-mute -mt-2"></div>
        <div><label class="label" for="rNote">요청 사항</label><textarea id="rNote" rows="3" class="field resize-none" placeholder="구매 품목, 인증 방법 등을 적어주세요"></textarea></div>
        <label class="flex items-start gap-2.5 text-sm text-mute cursor-pointer"><input id="rAgree" type="checkbox" class="mt-0.5 accent-[#FF6A3D]" />안전결제(에스크로) 이용 및 신고 정책에 동의합니다.</label>
        <div id="reqError" class="hidden text-sm text-bad"></div>
        <button type="submit" class="btn-primary h-11 w-full"><i data-lucide="send" class="w-4 h-4"></i>의뢰 등록하기</button>
      </form>

      <div class="lg:col-span-2 space-y-4">
        <div class="card p-6">
          <div class="text-sm font-semibold mb-4">결제 예상 금액</div>
          <div class="space-y-2.5 text-sm">
            <div class="flex justify-between"><span class="text-mute">웃돈</span><span id="sumFee">0원</span></div>
            <div class="flex justify-between"><span class="text-mute">플랫폼 수수료 (5%)</span><span id="sumCommission">0원</span></div>
            <div class="border-t border-line pt-3 flex justify-between font-semibold"><span>총 결제</span><span id="sumTotal" class="text-brand text-lg">0원</span></div>
          </div>
          <p class="text-xs text-dim mt-4 flex gap-1.5"><i data-lucide="lock" class="w-3.5 h-3.5 shrink-0"></i>수행 인증 전까지 금액은 안전하게 보관돼요.</p>
        </div>
        <div class="card p-6">
          <div class="text-sm font-semibold mb-3">내 의뢰</div>
          <div id="myRequests" class="space-y-2">${myRequests()}</div>
        </div>
      </div>
    </div>`;
  },

  waiters() {
    const list = WAITERS.filter(w => state.waiterFilter === 'all' || (state.waiterFilter === 'online' && w.online) || (state.waiterFilter === 'verified' && w.verified));
    const f = [['all', '전체'], ['online', '지금 활동 중'], ['verified', '인증 완료']];
    return `
    ${sectionHead('웨이터 목록', '모든 웨이터는 익명 ID로 표시돼요.', `<div class="hidden sm:flex gap-1.5">${f.map(([k, l]) => `<button class="chip chip-btn ${state.waiterFilter === k ? 'active' : ''}" data-wf="${k}">${l}</button>`).join('')}</div>`)}
    <div class="flex sm:hidden gap-1.5 mb-4">${f.map(([k, l]) => `<button class="chip chip-btn ${state.waiterFilter === k ? 'active' : ''}" data-wf="${k}">${l}</button>`).join('')}</div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      ${list.map(w => `
        <div class="card p-5">
          <div class="flex items-center gap-3">
            <div class="relative">
              <div class="w-11 h-11 rounded-full bg-card border border-line grid place-items-center"><i data-lucide="user-round" class="w-5 h-5 text-mute"></i></div>
              <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-panel ${w.online ? 'bg-ok' : 'bg-dim'}"></span>
            </div>
            <div class="min-w-0">
              <div class="font-semibold flex items-center gap-1.5">${w.id}${w.verified ? '<i data-lucide="badge-check" class="w-4 h-4 text-info"></i>' : ''}</div>
              <div class="text-xs text-mute flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3"></i>${w.area}</div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 mt-5">
            <div class="rounded-lg bg-bg border border-line p-3"><div class="text-[11px] text-dim">평점</div><div class="font-semibold mt-0.5 flex items-center gap-1"><i data-lucide="star" class="w-3.5 h-3.5 text-warn fill-warn"></i>${w.rating}</div></div>
            <div class="rounded-lg bg-bg border border-line p-3"><div class="text-[11px] text-dim">수행</div><div class="font-semibold mt-0.5">${w.jobs}건</div></div>
          </div>
          <div class="flex gap-1.5 mt-4">${w.tags.map(t => `<span class="chip">${t}</span>`).join('')}</div>
          <button class="btn-ghost h-10 w-full mt-5 text-sm" data-chatwith="${w.id}"><i data-lucide="message-circle" class="w-4 h-4"></i>익명 채팅 시작</button>
        </div>`).join('')}
    </div>`;
  },

  chat() {
    const active = state.chats.find(c => c.id === state.activeChat) || state.chats[0];
    return `
    ${sectionHead('익명 채팅', '개인정보는 자동으로 가려져요.')}
    <div class="card overflow-hidden grid md:grid-cols-[260px_1fr] h-[calc(100vh-260px)] min-h-[440px]">
      <div class="border-r border-line hidden md:flex flex-col">
        <div class="px-4 py-3 text-xs text-dim border-b border-line">대화 ${state.chats.length}</div>
        <div class="overflow-y-auto scroll-thin">
        ${state.chats.map(c => {
          const last = c.msgs[c.msgs.length - 1];
          return `<button data-chat="${c.id}" class="w-full text-left px-4 py-3.5 flex gap-3 items-center border-b border-line ${c.id === active.id ? 'bg-card' : 'hover:bg-card/60'}">
            <div class="w-9 h-9 rounded-full bg-bg border border-line grid place-items-center shrink-0"><i data-lucide="user-round" class="w-4 h-4 text-mute"></i></div>
            <div class="min-w-0 flex-1"><div class="flex justify-between text-sm font-medium"><span>${c.id}</span><span class="text-[11px] text-dim font-normal">${last ? last.t : ''}</span></div><div class="text-xs text-mute truncate mt-0.5">${last ? escapeHtml(last.text) : '대화를 시작해보세요'}</div></div>
          </button>`;
        }).join('')}
        </div>
      </div>
      <div class="flex flex-col min-h-0">
        <div class="h-14 px-5 border-b border-line flex items-center gap-3">
          <div class="font-semibold text-sm">${active.id}</div>
          <span class="chip text-[11px]"><i data-lucide="eye-off" class="w-3 h-3"></i>익명</span>
          <button data-go="report" class="ml-auto text-xs text-mute hover:text-bad inline-flex items-center gap-1"><i data-lucide="flag" class="w-3.5 h-3.5"></i>신고</button>
        </div>
        <div id="msgList" class="flex-1 overflow-y-auto scroll-thin p-5 space-y-3">
          <div class="text-center"><span class="text-[11px] text-dim border border-line rounded-full px-3 py-1">외부 연락처 공유 시 자동으로 가려집니다</span></div>
          ${active.msgs.map(m => `
            <div class="flex ${m.me ? 'justify-end' : ''}">
              <div class="max-w-[75%]">
                <div class="px-3.5 py-2.5 rounded-2xl text-sm leading-relaxed ${m.me ? 'bg-brand text-bg rounded-br-md font-medium' : 'bg-card border border-line rounded-bl-md'}">${escapeHtml(m.text)}</div>
                <div class="text-[10px] text-dim mt-1 ${m.me ? 'text-right' : ''}">${m.t}</div>
              </div>
            </div>`).join('')}
        </div>
        <form id="chatForm" class="p-3 border-t border-line flex gap-2">
          <input id="chatInput" class="field" placeholder="메시지를 입력하세요" autocomplete="off" />
          <button class="btn-primary w-11 shrink-0" aria-label="보내기"><i data-lucide="send" class="w-4 h-4"></i></button>
        </form>
      </div>
    </div>`;
  },

  report() {
    const types = ['노쇼 / 잠적', '허위 인증', '추가 금액 요구', '개인정보 요구', '기타'];
    return `
    ${sectionHead('치터 신고', '증거를 첨부하면 24시간 이내 검토 후 결과를 알려드려요.')}
    <div class="grid lg:grid-cols-5 gap-4">
      <form id="reportForm" class="card p-6 lg:col-span-3 space-y-5" novalidate>
        <div><label class="label" for="rpTarget">신고 대상 ID</label><input id="rpTarget" class="field" placeholder="예) W-1234" /></div>
        <div>
          <span class="label">신고 유형</span>
          <div class="flex flex-wrap gap-1.5" id="rpTypes">${types.map((t, i) => `<button type="button" class="chip chip-btn ${i === 0 ? 'active' : ''}" data-rtype="${t}">${t}</button>`).join('')}</div>
        </div>
        <div><label class="label" for="rpDesc">상세 내용</label><textarea id="rpDesc" rows="4" class="field resize-none" placeholder="언제, 어디서, 어떤 일이 있었는지 적어주세요 (10자 이상)"></textarea></div>
        <div>
          <span class="label">증거 자료</span>
          <label class="flex flex-col items-center justify-center gap-2 border border-dashed border-line rounded-xl p-6 cursor-pointer hover:border-mute transition text-center">
            <i data-lucide="image-plus" class="w-6 h-6 text-mute"></i>
            <span class="text-sm text-mute" id="fileLabel">채팅 캡처, 현장 사진 등을 올려주세요</span>
            <input id="rpFile" type="file" accept="image/*" multiple class="hidden" />
          </label>
        </div>
        <div id="rpError" class="hidden text-sm text-bad"></div>
        <button class="btn-primary h-11 w-full"><i data-lucide="shield-alert" class="w-4 h-4"></i>신고 접수하기</button>
      </form>
      <div class="lg:col-span-2 card p-6 h-fit">
        <div class="text-sm font-semibold mb-4">처리 절차</div>
        <ol class="space-y-5">
          ${[['신고 접수', '증거와 함께 신고가 등록돼요.', 'inbox'], ['운영팀 검토', '채팅 기록과 인증 자료를 확인해요.', 'search-check'], ['조치 & 환불', '확인 시 계정 제재 및 의뢰금 환불', 'gavel']]
            .map(([t, d, ic], i) => `<li class="flex gap-3"><div class="w-8 h-8 rounded-full bg-brand-soft text-brand grid place-items-center shrink-0"><i data-lucide="${ic}" class="w-4 h-4"></i></div><div><div class="text-sm font-medium">${i + 1}. ${t}</div><div class="text-xs text-mute mt-0.5">${d}</div></div></li>`).join('')}
        </ol>
      </div>
    </div>`;
  },
};

function marketCard(m) {
  return `<div class="card p-5">
    <div class="flex items-center justify-between"><span class="chip">${m.cat}</span>${changeBadge(m.change)}</div>
    <div class="font-semibold mt-4 truncate">${m.name}</div>
    <div class="text-xs text-mute mt-0.5">${m.area}</div>
    <div class="flex items-end justify-between mt-5">
      <div><div class="text-[11px] text-dim">평균 웃돈</div><div class="text-lg font-bold">${won(m.price)}</div></div>
      <div class="text-xs text-mute flex items-center gap-1"><i data-lucide="users" class="w-3.5 h-3.5"></i>${m.waiters}</div>
    </div>
  </div>`;
}

function myRequests() {
  if (!state.requests.length) return `<div class="text-sm text-mute">등록한 의뢰가 없어요.</div>`;
  return state.requests.map(r => `
    <div class="rounded-lg bg-bg border border-line p-3.5 flex items-center gap-3">
      <div class="min-w-0 flex-1"><div class="text-sm font-medium truncate">${escapeHtml(r.place)}</div><div class="text-xs text-mute mt-0.5">${r.date} · ${won(r.fee)}</div></div>
      <span class="chip text-[11px] border-warn/30 text-warn">${r.status}</span>
    </div>`).join('');
}

function heroArt() {
  let dots = '';
  for (let i = 0; i < 7; i++) {
    const x = 60 + i * 52, active = i === 3;
    dots += `<g transform="translate(${x},${150 + Math.sin(i) * 6})"><circle r="14" cy="-34" fill="${active ? '#FF6A3D' : '#232835'}"/><rect x="-16" y="-16" width="32" height="46" rx="12" fill="${active ? '#FF6A3D' : '#232835'}"/></g>`;
  }
  return `<svg viewBox="0 0 440 300" class="w-full h-full" preserveAspectRatio="xMidYMid slice">
    <line x1="30" y1="190" x2="420" y2="190" stroke="#232835" stroke-dasharray="4 6"/>
    ${dots}
    <g transform="translate(216,72)"><rect x="-38" y="-16" width="76" height="28" rx="14" fill="#171B24" stroke="#FF6A3D"/><text x="0" y="3" text-anchor="middle" font-size="12" font-weight="700" fill="#FF6A3D" font-family="sans-serif">+45,000</text></g>
  </svg>`;
}

function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

/* ---------- render ---------- */
function renderNav() {
  $('#sideNav').innerHTML = MENU.map(m => `<button class="nav-item ${state.view === m.id ? 'active' : ''}" data-go="${m.id}"><i data-lucide="${m.icon}" class="w-[18px] h-[18px]"></i>${m.label}</button>`).join('');
  $('#tabNav').innerHTML = MENU.map(m => `<button class="tab-item ${state.view === m.id ? 'active' : ''}" data-go="${m.id}"><i data-lucide="${m.icon}" class="w-5 h-5"></i>${m.label.replace(' 보기', '').replace(' 목록', '')}</button>`).join('');
}

function render() {
  renderNav();
  $('#pageTitle').textContent = MENU.find(m => m.id === state.view).label;
  const v = $('#view');
  v.innerHTML = `<div class="fade-in">${views[state.view]()}</div>`;
  icon();
  bindView();
}

function go(id) {
  if (!views[id]) return;
  state.view = id;
  location.hash = id;
  render();
  window.scrollTo({ top: 0 });
}

function bindView() {
  if (state.view === 'market') {
    const s = $('#marketSearch');
    s.addEventListener('input', e => {
      state.marketQuery = e.target.value;
      const pos = e.target.selectionStart;
      render();
      const n = $('#marketSearch'); n.focus(); n.setSelectionRange(pos, pos);
    });
  }
  if (state.view === 'request') {
    const d = $('#rDate');
    d.value = new Date().toISOString().slice(0, 10);
    const place = $('#rPlace'), fee = $('#rFee');
    const update = () => {
      const f = Math.max(0, Number(fee.value) || 0);
      const c = Math.round(f * 0.05);
      $('#sumFee').textContent = won(f);
      $('#sumCommission').textContent = won(c);
      $('#sumTotal').textContent = won(f + c);
      const m = MARKET.find(x => x.name === place.value.trim());
      $('#feeHint').innerHTML = m ? `<span class="inline-flex items-center gap-1"><i data-lucide="info" class="w-3.5 h-3.5"></i>이 장소의 평균 웃돈은 <b class="text-ink">${won(m.price)}</b>, 현재 ${m.waiters}명이 대기 중이에요.</span>` : '';
      icon();
    };
    place.addEventListener('input', update);
    fee.addEventListener('input', update);
    $('#reqForm').addEventListener('submit', e => {
      e.preventDefault();
      const err = $('#reqError');
      const f = Number(fee.value);
      let msg = '';
      if (!place.value.trim()) msg = '장소를 입력해주세요.';
      else if (!f || f < 5000) msg = '웃돈은 5,000원 이상 입력해주세요.';
      else if (!$('#rAgree').checked) msg = '안전결제 정책에 동의해주세요.';
      if (msg) { err.textContent = msg; err.classList.remove('hidden'); return; }
      err.classList.add('hidden');
      state.requests.unshift({ id: 'R-' + Math.floor(1000 + Math.random() * 9000), place: place.value.trim(), date: `${d.value.slice(5).replace('-', '/')} ${$('#rTime').value}`, fee: f, status: '매칭 중' });
      $('#myRequests').innerHTML = myRequests();
      e.target.reset(); d.value = new Date().toISOString().slice(0, 10); update();
      toast('의뢰가 등록됐어요. 웨이터 매칭을 시작합니다.');
    });
  }
  if (state.view === 'chat') {
    const list = $('#msgList'); list.scrollTop = list.scrollHeight;
    $('#chatForm').addEventListener('submit', e => {
      e.preventDefault();
      const input = $('#chatInput');
      let text = input.value.trim();
      if (!text) return;
      text = text.replace(/01[0-9][-\s.]?\d{3,4}[-\s.]?\d{4}/g, '***-****-****');
      const c = state.chats.find(x => x.id === state.activeChat);
      const now = new Date(); const t = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      c.msgs.push({ me: true, text, t });
      render();
      $('#chatInput').focus();
      setTimeout(() => {
        c.msgs.push({ me: false, text: '확인했습니다! 진행 상황은 여기로 공유드릴게요.', t });
        if (state.view === 'chat' && state.activeChat === c.id) { render(); $('#chatInput').focus(); }
      }, 1200);
    });
  }
  if (state.view === 'report') {
    $('#rpFile').addEventListener('change', e => {
      const n = e.target.files.length;
      $('#fileLabel').textContent = n ? `${n}개 파일 선택됨` : '채팅 캡처, 현장 사진 등을 올려주세요';
    });
    $('#reportForm').addEventListener('submit', e => {
      e.preventDefault();
      const err = $('#rpError');
      let msg = '';
      if (!$('#rpTarget').value.trim()) msg = '신고 대상 ID를 입력해주세요.';
      else if ($('#rpDesc').value.trim().length < 10) msg = '상세 내용을 10자 이상 입력해주세요.';
      if (msg) { err.textContent = msg; err.classList.remove('hidden'); return; }
      err.classList.add('hidden');
      e.target.reset();
      $('#fileLabel').textContent = '채팅 캡처, 현장 사진 등을 올려주세요';
      toast('신고가 접수됐어요. 24시간 이내 결과를 알려드릴게요.');
    });
  }
}

document.addEventListener('click', e => {
  const g = e.target.closest('[data-go]');
  if (g) { go(g.dataset.go); return; }
  const cat = e.target.closest('[data-cat]');
  if (cat) { state.marketCat = cat.dataset.cat; render(); return; }
  const wf = e.target.closest('[data-wf]');
  if (wf) { state.waiterFilter = wf.dataset.wf; render(); return; }
  const cw = e.target.closest('[data-chatwith]');
  if (cw) {
    const id = cw.dataset.chatwith;
    if (!state.chats.find(c => c.id === id)) state.chats.unshift({ id, msgs: [] });
    state.activeChat = id; go('chat'); return;
  }
  const ch = e.target.closest('[data-chat]');
  if (ch) { state.activeChat = ch.dataset.chat; render(); return; }
  const rt = e.target.closest('[data-rtype]');
  if (rt) { document.querySelectorAll('[data-rtype]').forEach(b => b.classList.toggle('active', b === rt)); }
});

const initial = location.hash.slice(1);
if (views[initial]) state.view = initial;
render();

