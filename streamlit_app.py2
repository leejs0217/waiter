  view: 'home',
  marketCat: '전체',
  marketQuery: '',
  waiterFilter: 'all',
  requests: [
    { id: 'R-1042', place: '성수 팝업스토어', date: '오늘 09:00', fee: 45000, status: '매칭 중' },
  ],
  chats: [
    { id: 'W-8812', msgs: [
      { me: false, text: '안녕하세요! 성수 팝업 의뢰 보고 연락드려요.', t: '08:41' },
      { me: true, text: '네 안녕하세요. 오전 9시 시작 가능하실까요?', t: '08:42' },
      { me: false, text: '네 가능합니다. 도착하면 현장 사진으로 인증드릴게요.', t: '08:43' },
    ]},
    { id: 'W-1194', msgs: [{ me: false, text: '굿즈 오픈런 몇 개 구매 원하시나요?', t: '어제' }] },
  ],
  activeChat: 'W-8812',
};

/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
function icon() { createIcons({ icons }); }
function toast(msg, type = 'ok') {
  const el = $('#toast');
  const color = type === 'ok' ? 'text-ok' : 'text-bad';
  const ic = type === 'ok' ? 'circle-check' : 'circle-alert';
  el.innerHTML = `<div class="fade-in flex items-center gap-2 rounded-full border border-line bg-card px-4 py-2.5 text-sm"><i data-lucide="${ic}" class="w-4 h-4 ${color}"></i>${msg}</div>`;
  el.classList.remove('hidden');
  icon();
  clearTimeout(toast._t);
  toast._t = setTimeout(() => el.classList.add('hidden'), 2600);
}
function sectionHead(title, desc, right = '') {
  return `<div class="flex items-end justify-between gap-4 mb-5"><div><h2 class="text-xl font-bold tracking-tight">${title}</h2>${desc ? `<p class="text-sm text-mute mt-1">${desc}</p>` : ''}</div>${right}</div>`;
}
function changeBadge(c) {
  if (c > 0) return `<span class="inline-flex items-center gap-0.5 text-xs font-semibold text-bad"><i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>${c}%</span>`;
  if (c < 0) return `<span class="inline-flex items-center gap-0.5 text-xs font-semibold text-info"><i data-lucide="arrow-down-right" class="w-3.5 h-3.5"></i>${Math.abs(c)}%</span>`;
  return `<span class="text-xs font-semibold text-mute">보합</span>`;
}

/* ---------- views ---------- */
const views = {
  home() {
    const features = [
      { icon: 'lock', title: '안전결제', desc: '에스크로로 의뢰금을 보호해요. 수행 인증 후에만 정산됩니다.' },
      { icon: 'bar-chart-3', title: '가격 투명성', desc: '실시간 시세와 대기 중인 웨이터 수를 함께 보여드려요.' },
      { icon: 'message-circle', title: '익명 채팅', desc: '전화번호, 이름 등 개인정보 노출 없이 바로 시작해요.' },
      { icon: 'shield-alert', title: '치터 신고', desc: '증거 기반 신고 시스템으로 불량 이용자를 걸러내요.' },
    ];
    const steps = [
      { n: '01', title: '의뢰 등록', desc: '장소, 시간, 웃돈을 입력해요.', icon: 'file-plus-2' },
      { n: '02', title: '웨이터 매칭', desc: '익명 채팅으로 세부 조건을 조율해요.', icon: 'users' },
      { n: '03', title: '수행 & 정산', desc: '현장 인증 후 안전결제로 정산돼요.', icon: 'badge-check' },
    ];
    return `
    <section class="card p-7 lg:p-10 overflow-hidden relative">
      <div class="absolute right-0 top-0 bottom-0 w-1/2 hidden md:block opacity-60 pointer-events-none">${heroArt()}</div>
      <div class="relative max-w-lg">
        <span class="chip border-brand/30 text-brand"><span class="w-1.5 h-1.5 rounded-full bg-brand"></span>대리 웨이팅 플랫폼</span>
        <h2 class="text-3xl lg:text-[40px] font-bold tracking-tight leading-tight mt-5">줄 서는 시간을<br/><span class="text-brand">돈으로</span> 바꾸세요</h2>
        <p class="text-mute mt-4 leading-relaxed">인기 상품, 팝업, 맛집 웨이팅을 안전하게 맡기세요.<br class="hidden sm:block"/>익명 채팅 · 안전결제 · 실시간 시세 지원</p>
        <div class="flex flex-wrap gap-2.5 mt-7">
          <button data-go="request" class="btn-primary h-11 px-5"><i data-lucide="file-plus-2" class="w-4 h-4"></i>웨이팅 의뢰하기</button>
          <button data-go="market" class="btn-ghost h-11 px-5"><i data-lucide="trending-up" class="w-4 h-4"></i>시세 보기</button>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-4">
      ${[['누적 의뢰', '12,480건', 'clipboard-list'], ['활동 웨이터', '1,326명', 'users'], ['평균 매칭', '7분', 'timer'], ['분쟁 해결률', '99.2%', 'shield-check']]
        .map(([k, v, ic]) => `<div class="card p-5"><div class="flex items-center gap-2 text-xs text-mute"><i data-lucide="${ic}" class="w-3.5 h-3.5"></i>${k}</div><div class="text-2xl font-bold mt-2 tracking-tight">${v}</div></div>`).join('')}
    </section>

    <section class="mt-12">
      ${sectionHead('왜 waiter인가요?', '믿고 맡길 수 있는 웨이팅 거래를 위한 네 가지 약속')}
      <div class="grid sm:grid-cols-2 gap-3">
        ${features.map(f => `
          <div class="card p-6 flex gap-4 hover:border-[#2f3546] transition">
            <div class="w-11 h-11 shrink-0 rounded-xl bg-brand-soft text-brand grid place-items-center"><i data-lucide="${f.icon}" class="w-5 h-5"></i></div>
            <div><div class="font-semibold">${f.title}</div><p class="text-sm text-mute mt-1 leading-relaxed">${f.desc}</p></div>
          </div>`).join('')}
      </div>
    </section>

    <section class="mt-12">
      ${sectionHead('이용 방법', '3단계면 충분해요')}
