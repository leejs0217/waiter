  { name: '런던 베이글 뮤지엄', cat: '맛집', area: '서울 종로구', price: 25000, change: -4, waiters: 32, wait: '2~3시간' },
  { name: '캐릭터 굿즈 오픈런', cat: '인기 상품', area: '서울 마포구', price: 35000, change: 8, waiters: 14, wait: '3시간' },
  { name: '부산 돼지국밥 맛집', cat: '맛집', area: '부산 해운대구', price: 15000, change: 0, waiters: 21, wait: '1~2시간' },
  { name: '아이돌 생일카페', cat: '팝업', area: '서울 용산구', price: 30000, change: -6, waiters: 11, wait: '2시간' },
  { name: '명품 매장 오픈런', cat: '인기 상품', area: '서울 중구', price: 70000, change: 15, waiters: 7, wait: '5시간' },
  { name: '제주 카페 브런치', cat: '맛집', area: '제주 제주시', price: 18000, change: 3, waiters: 6, wait: '1시간' },
