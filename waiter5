def go(page):
    st.session_state.page = page
    st.session_state.selected_popup = None

def popup_card(p):
    st.markdown(
        f"""<div class="popup-card">
        <div class="popup-visual" style="background:{p['color']}">{p['emoji']}</div>
        <div class="popup-info">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:9px">
            <span class="tag">{p['tag']}</span><span class="sub">{p['category']}</span>
          </div>
          <div class="popup-name">{p['name']}</div>
          <div class="popup-meta">📍 {p['place']}<br>📅 {p['period']}</div>
        </div></div>""",
        unsafe_allow_html=True
    )

# Header
h1, h2 = st.columns([3, 1])
with h1:
    st.markdown('<div class="brand">POP<span>ZIP</span> ✦</div><div class="sub">지금 가장 가보고 싶은 팝업스토어</div>', unsafe_allow_html=True)
with h2:
    st.write("")
    if st.button("♡ 찜 목록", use_container_width=True):
        go("찜")

st.write("")
if st.session_state.page == "상세" and st.session_state.selected_popup:
    p = next((x for x in POPS if x["id"] == st.session_state.selected_popup), None)
    if p:
        if st.button("← 목록으로"):
            go("홈")
        st.markdown(f"""<div class="detail-box">
        <div class="popup-visual" style="height:220px;background:{p['color']};border-radius:14px">{p['emoji']}</div>
        <p class="sub">{p['category']} · {p['tag']}</p>
        <h1 style="font-size:30px;font-weight:900">{p['name']}</h1>
        <p style="color:#777">{p['description']}</p>
        <hr><b>📍 위치</b><p>{p['place']}</p>
        <b>📅 운영 기간</b><p>{p['period']}</p>
        </div>""", unsafe_allow_html=True)
        a, b = st.columns(2)
        with a:
            if st.button("♡ 찜하기", use_container_width=True):
                st.session_state.favorites.add(p["id"])
                st.success("찜 목록에 저장했어요.")
        with b:
            st.button("방문 예정", use_container_width=True, disabled=True)
    st.stop()

# Hero
st.markdown("""
<div class="hero">
 <div class="hero-kicker">POPUP STORE DISCOVERY</div>
 <div class="hero-title">취향을 발견하는 순간,<br>새로운 팝업을 만나다.</div>
 <div class="hero-desc">패션부터 전시까지, 지금 주목받는 팝업을 한눈에.</div>
</div>
""", unsafe_allow_html=True)

# Search and category navigation
st.markdown('<div class="section-title">어떤 팝업을 찾으세요?</div>', unsafe_allow_html=True)
query = st.text_input("검색", placeholder="팝업 이름, 지역, 카테고리를 검색해 보세요", label_visibility="collapsed")

st.markdown('<div class="section-title">카테고리</div><div class="section-sub">관심 있는 분야를 선택해 팝업을 둘러보세요.</div>', unsafe_allow_html=True)
cat_cols = st.columns(4)
cat_icons = ["⌂", "🧥", "🧁", "🧸", "💄", "🪴", "🎨", "🎮"]
for i, cat in enumerate(CATEGORIES):
    with cat_cols[i % 4]:
        label = f"{cat_icons[i]}  {cat}"
        if st.button(label, key=f"cat_{i}", type="primary" if st.session_state.category == cat else "secondary", use_container_width=True):
            st.session_state.category = cat
            st.session_state.page = "홈"
            st.rerun()

# Listing
if st.session_state.page == "찜":
    st.markdown('<div class="section-title">나의 찜 목록 ♡</div><div class="section-sub">관심 있는 팝업을 모아봤어요.</div>', unsafe_allow_html=True)
    filtered = [p for p in POPS if p["id"] in st.session_state.favorites]
else:
    st.markdown('<div class="section-title">지금 인기 있는 팝업</div><div class="section-sub">새로운 경험을 발견해 보세요.</div>', unsafe_allow_html=True)
    filtered = [p for p in POPS if st.session_state.category == "전체" or p["category"] == st.session_state.category]

if query.strip():
    q = query.strip().lower()
    filtered = [p for p in filtered if q in p["name"].lower() or q in p["place"].lower() or q in p["category"].lower()]

sort = st.selectbox("정렬", ["추천순", "최신순", "이름순"], label_visibility="collapsed")
if sort == "이름순":
    filtered = sorted(filtered, key=lambda x: x["name"])
elif sort == "최신순":
    filtered = list(reversed(filtered))

st.caption(f"{len(filtered)}개의 팝업스토어")
if not filtered:
    st.info("조건에 맞는 팝업이 없어요. 다른 카테고리나 검색어를 선택해 보세요.")
else:
    cols = st.columns(2)
    for idx, p in enumerate(filtered):
        with cols[idx % 2]:
            popup_card(p)
            c1, c2 = st.columns([3, 1])
            with c1:
                if st.button("자세히 보기", key=f"detail_{p['id']}", use_container_width=True):
                    st.session_state.selected_popup = p["id"]
                    st.session_state.page = "상세"
                    st.rerun()
            with c2:
                fav_label = "♥" if p["id"] in st.session_state.favorites else "♡"
                if st.button(fav_label, key=f"fav_{p['id']}", use_container_width=True):
                    if p["id"] in st.session_state.favorites:
                        st.session_state.favorites.remove(p["id"])
                    else:
                        st.session_state.favorites.add(p["id"])
                    st.rerun()

st.markdown("---")
nav = st.columns(4)
for col, label, page in zip(nav, ["⌂ 홈", "▦ 카테고리", "♡ 찜", "☻ 마이"], ["홈", "카테고리", "찜", "마이"]):
    with col:
        if st.button(label, use_container_width=True, type="primary" if st.session_state.page == page else "secondary"):
            if page == "카테고리":
                st.session_state.category = "전체"
                st.session_state.page = "홈"
            elif page == "마이":
                st.info("마이페이지 기능은 다음 단계에서 연결할 수 있어요.")
            else:
                go(page)
            st.rerun()

st.caption("POPZIP · 팝업스토어 탐색 서비스 | 현재 화면의 팝업 정보는 디자인 확인용 예시 데이터입니다.")
